generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GESTOR
  COORDENADOR
  COLABORADOR
  CONSULTA
}

enum ClientProjectStatus {
  ATIVO
  INATIVO
  EM_IMPLANTACAO
  PAUSADO
  ENCERRADO
}

enum AccountingTaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  IMUNE_ISENTA
}

enum AccountingActivity {
  COMERCIO
  SERVICO
  COMERCIO_SERVICO
}

enum ClosingModule {
  FISCAL
  FOLHA
}

enum ClosingCellStatus {
  NAO_APLICA
  PENDENTE
  OK
  SEM_MOVIMENTO
  NAO_DEVIDO
  ATENCAO
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  AGUARDANDO_DOCUMENTO
  EM_REVISAO
  CONCLUIDO
  ATRASADO
  CANCELADO
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

// O escritório. Uma única organização por instalação; o campo existe para
// manter os dados isolados caso mais escritórios usem o mesmo banco.
model Organization {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  departments    Department[]
  clientProjects ClientProject[]
  tasks          Task[]
  closingRows    ClosingRow[]
  closingCells   ClosingCell[]
}

// Colaborador do escritório. Só entra quem for cadastrado pela Equipe.
model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  passwordHash       String
  role               UserRole        @default(COLABORADOR)
  active             Boolean         @default(true)
  organizationId     String
  departmentId       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  mainClientProjects ClientProject[] @relation("ClientProjectMainResponsible")
  responsibleTasks   Task[]          @relation("TaskResponsible")
  createdTasks       Task[]          @relation("TaskCreator")
  comments           TaskComment[]
  histories          TaskHistory[]
  closingRows        ClosingRow[]
  closingCells       ClosingCell[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([active])
}

model Department {
  id             String       @id @default(cuid())
  name           String
  description    String?
  active         Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  tasks          Task[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Empresa cliente do escritório (uma linha da planilha).
model ClientProject {
  id                    String               @id @default(cuid())
  code                  String?
  name                  String
  document              String?
  stateRegistration     String?
  districtRegistration  String?
  status                ClientProjectStatus  @default(ATIVO)
  notes                 String?
  accountingTaxRegime   AccountingTaxRegime?
  accountingActivity    AccountingActivity?
  accountingState       String?
  hasMonthlyMovement    Boolean              @default(true)
  issuesInvoices        Boolean              @default(false)
  hasRentalIrrf         Boolean              @default(false)
  employeesCount        Int?
  modules               ClosingModule[]      @default([FISCAL, FOLHA])
  stepOverrides         Json                 @default("{}")
  mainResponsibleUserId String?
  organizationId        String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainResponsible       User?                @relation("ClientProjectMainResponsible", fields: [mainResponsibleUserId], references: [id], onDelete: SetNull)
  tasks                 Task[]
  closingRows           ClosingRow[]
  closingCells          ClosingCell[]

  @@index([organizationId])
  @@index([status])
  @@index([code])
  @@index([accountingTaxRegime])
  @@index([accountingState])
  @@index([mainResponsibleUserId])
}

// Linha da matriz de fechamento (empresa x módulo x competência).
model ClosingRow {
  id              String        @id @default(cuid())
  organizationId  String
  clientProjectId String
  module          ClosingModule
  competence      String
  noMovement      Boolean?
  note            String?
  updatedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientProject   ClientProject @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)
  updatedBy       User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([clientProjectId, module, competence])
  @@index([organizationId, module, competence])
}

// Célula editada da matriz. Células não editadas são derivadas do perfil da empresa.
model ClosingCell {
  id              String            @id @default(cuid())
  organizationId  String
  clientProjectId String
  module          ClosingModule
  competence      String
  stepKey         String
  status          ClosingCellStatus @default(PENDENTE)
  note            String?
  doneAt          DateTime?
  updatedById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientProject   ClientProject     @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)
  updatedBy       User?             @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([clientProjectId, module, competence, stepKey])
  @@index([organizationId, module, competence])
  @@index([status])
}

// Tarefa avulsa (demanda fora da rotina fixa).
model Task {
  id              String         @id @default(cuid())
  title           String
  description     String?
  dueDate         DateTime
  status          TaskStatus     @default(PENDENTE)
  priority        TaskPriority   @default(MEDIA)
  internalNotes   String?
  completedAt     DateTime?
  organizationId  String
  clientProjectId String?
  departmentId    String
  responsibleId   String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientProject   ClientProject? @relation(fields: [clientProjectId], references: [id], onDelete: SetNull)
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  responsible     User?          @relation("TaskResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdBy       User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments        TaskComment[]
  histories       TaskHistory[]

  @@index([organizationId])
  @@index([clientProjectId])
  @@index([departmentId])
  @@index([responsibleId])
  @@index([dueDate])
  @@index([status])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskHistory {
  id            String   @id @default(cuid())
  taskId        String
  userId        String?
  action        String
  previousValue String?
  newValue      String?
  createdAt     DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
}
