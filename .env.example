# PostgreSQL (no Render, use a Internal Database URL e acrescente ?schema=studio_gestor)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=studio_gestor"

# NextAuth: gere um segredo forte (ex.: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Administrador principal, criado automaticamente no primeiro login
ADMIN_EMAIL="studiotaxtributos@gmail.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Studio Tax"
ORGANIZATION_NAME="Studio Tax"
